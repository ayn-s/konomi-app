# api/.env.example をコピーして api/.env を作ります。

# PostgreSQL の接続先(例はこのパソコンの PostgreSQL)
DATABASE_URL=postgres://konomi:konomi@localhost:5432/konomi
# クラウドの PostgreSQL で SSL が必要なときは true
DATABASE_SSL=false

# api サーバーのポート
PORT=3001

# 画面を別の場所(GitHub Pages など)に置くときだけ、その URL(カンマ区切りで複数可)
# 例: CORS_ORIGIN=https://<ユーザー名>.github.io
CORS_ORIGIN=

# Render などのホスティングの後ろで動かすときは 1(接続元の IP を正しく数えるため)
TRUST_PROXY=
