# web/.env.example をコピーして web/.env を作り、必要なところだけ書きます。
# 書き換えたら npm run dev / npm run build をやり直してください。

# --- 履歴の保存先(上から順に、書いてあるものを使います。全部空なら、この端末のブラウザ内) ---
# 1. このプロジェクトの api サーバー(PostgreSQL)。api と同じ場所で動かすときは /api
VITE_API_URL=
# 2. Supabase(Project URL と Publishable key / anon public キー。secret キーは絶対に書かない)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# --- QRコードに入れるURL(空なら、いま開いているページのURL) ---
VITE_SITE_URL=
